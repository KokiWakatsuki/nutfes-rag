# Google OAuth（NextAuth.js 用）
# Google Cloud Console > APIs & Services > Credentials で取得
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth.js シークレット（openssl rand -base64 32 で生成）
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# 許可するメールアドレスのサフィックス
ALLOWED_EMAIL_SUFFIX=.nutfes@gmail.com

# Google Cloud プロジェクト ID
# Cloud Console 上部のプロジェクト名横に表示される ID（例: nutfes-rag-497501）
GOOGLE_CLOUD_PROJECT=

# Supabase
# Supabase プロジェクト設定 > API から取得
SUPABASE_URL=
# anon key（クライアント用）は公開可能だが、ここでは service_role key を使用
SUPABASE_SERVICE_KEY=

# Google Service Account（Drive 同期 + Vertex AI 用）
# Google Cloud Console でサービスアカウントを作成し、JSON キーをダウンロードして
# 改行を \n に変換した文字列を設定（または JSON をそのまま設定）
GOOGLE_SERVICE_ACCOUNT_KEY=

# 同期 API の認証トークン（GitHub Actions から叩く場合）
# openssl rand -base64 32 で生成
CRON_SECRET=
GCS_BUCKET=
